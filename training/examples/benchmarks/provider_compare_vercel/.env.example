# The ONE env var this app needs. Paste a JSON array of providers.
# `label` is the only thing the browser ever sees -- url/model/key stay server-side.
# `reasoningOff` = body fields to DISABLE reasoning (provider-specific):
#   Fireworks/Baseten -> {"reasoning_effort":"none"};  Together -> {"chat_template_kwargs":{"enable_thinking":false}}
# Keep it on a single line when pasting into the Vercel dashboard.
PROVIDERS=[{"label":"Fireworks GLM-5.2 Fast","url":"https://api.fireworks.ai/inference/v1/chat/completions","model":"accounts/fireworks/routers/glm-5p2-fast","key":"fw-...","reasoningOff":{"reasoning_effort":"none"}},{"label":"GLM-5.2 (Another Provider)","url":"https://inference.baseten.co/v1/chat/completions","model":"zai-org/GLM-5.2","key":"...","reasoningOff":{"reasoning_effort":"none"}},{"label":"GLM-5.2 (Yet another provider)","url":"https://api.together.xyz/v1/chat/completions","model":"zai-org/GLM-5.2","key":"...","reasoningOff":{"chat_template_kwargs":{"enable_thinking":false}}}]

# Optional: gate the deploy so only requests carrying this header can spend your
# API budget. If set, wire `X-Compare-Secret: <value>` into index.html's fetch.
# COMPARE_APP_SECRET=
