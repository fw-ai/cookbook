 describe("tool.shell truncation", () => {
+  it.live("finishes background commands without killing their server", () =>
+    runIn(projectRoot, Effect.gen(function* () {
+      const tmp = yield* tmpdirScoped()
+      const ready = path.join(tmp, "port")
+      const script = `require('http').createServer((q,r)=>r.end('alive')).listen(0,'127.0.0.1',function(){require('fs').writeFileSync(${JSON.stringify(ready)},String(this.address().port))});setInterval(()=>console.log('background heartbeat'),50)`
+      const started = performance.now()
+      const result = yield* run({
+        command: `${bin} -e ${JSON.stringify(script)} & bg=$!; while [ ! -s ${squote(ready)} ]; do sleep 0.01; done; echo SERVER_PID=$bg`,
+        timeout: 5000,
+      })
+      const pid = Number(result.output.match(/SERVER_PID=(\d+)/)?.[1])
+      expect(pid).toBeGreaterThan(0)
+      yield* Effect.addFinalizer(() => Effect.sync(() => process.kill(pid, "SIGKILL")))
+      expect(result.metadata.exit).toBe(0)
+      expect(performance.now() - started).toBeLessThan(3000)
+      const port = yield* Effect.promise(() => Bun.file(ready).text())
+      expect(yield* Effect.promise(() => fetch(`http://127.0.0.1:${port}`).then(r => r.text()))).toBe("alive")
+      // A second tool call proves the server survives after capture stops,
+      // including writes into the inherited stdout pipe.
+      const followup = yield* run({command: `sleep 0.3; kill -0 ${pid}; echo server-still-alive`, timeout: 2000})
+      expect(followup.metadata.exit).toBe(0)
+      expect(followup.output).toContain("server-still-alive")
+    })),
+  )
